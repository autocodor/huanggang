FROM openeuler/openeuler:24.03-lts-sp4

WORKDIR /app

# 复制项目文件
COPY requirements.txt .
COPY divers/HG/baoqi/testcv2.py ./divers/HG/baoqi/testcv2.py

RUN dnf install -y \
    python3 \
    python3-pip \
    libX11 \
    libXext \
    libXrender \
    libSM \
    mesa-libGL \
    glib2 \
    && dnf clean all

# 安装依赖
RUN pip3 install --no-cache-dir -i https://pypi.doubanio.com/simple -r requirements.txt

# 设置PYTHONPATH
ENV PYTHONPATH=/app

# 设置工作目录
WORKDIR /app/divers/HG/baoqi

# 运行应用程序
CMD ["python3", "testcv2.py"]